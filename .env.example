# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# DEMO_MODE: Set to "on" to enable demo login buttons and /api/demo-login for evaluation
DEMO_MODE="on"

# STAFF_EMAILS: Comma-separated list of approved institutional staff emails
STAFF_EMAILS="mdshameel740@gmail.com,systemkali741@gmail.com"

